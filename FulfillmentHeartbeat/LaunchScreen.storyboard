                                        <color key="backgroundColor" red="0.15" green="0.42" blue="0.95" alpha="0.35" colorSpace="custom" customColorSpace="sRGB"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="3" id="lh"/>
